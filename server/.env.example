# Required. Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Required. MongoDB connection string
MONGODB_URI=

# Cloudinary (required for restaurant image uploads)
CLOUDINARY_URL=

# Optional. Comma-separated list of allowed browser origins.
# Leave blank in development to allow any origin; ALWAYS set it in production.
CLIENT_URL=

# Optional. Defaults to 5000.
PORT=5000
